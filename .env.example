# Copy to .env and fill in the blanks:  cp .env.example .env

# --- Postgres (used by Docker Compose and the app) ---
POSTGRES_USER=home_repair_user
POSTGRES_PASSWORD=home_repair_pass
POSTGRES_DB=home_repair_db

# Must match the three values above (host/port assume docker compose or local Postgres)
DATABASE_URL=postgresql://home_repair_user:home_repair_pass@localhost:5432/home_repair_db

# --- OpenAI (required) ---
OPENAI_API_KEY=your-openai-api-key
# Optional; defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Tavily (optional) ---
# Leave empty to get a mock repair answer instead of live web search
TAVILY_API_KEY=
